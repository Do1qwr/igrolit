{
  "name": "game-launcher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "build:dev": "vite build --mode dev",
    "build:release": "vite build --mode production",
    "test:server": "node tests/server-smoke.cjs",
    "sign": "powershell -ExecutionPolicy Bypass -File scripts/sign.ps1",
    "app:dev": "npm run build:dev && tauri build --config src-tauri/tauri.dev.conf.json",
    "app:release": "npm run build:release && tauri build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:db": "node tests/db-safety.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tauri-apps/cli": "^1.5.0",
    "@tsconfig/svelte": "^5.0.0",
    "svelte": "^4.2.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
