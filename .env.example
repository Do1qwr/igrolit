# SECURITY KEYS — НЕ КОММИТЬ В GIT!
# Скопируй этот файл в .env и заполни случайными значениями.
JWT_SECRET=change-me-to-random-64-chars-string
IP_SALT=change-me-to-random-string
# 64 hex-символа (32 байта) — ключ AES-256-GCM для шифрования PII.
# Можно сгенерировать: openssl rand -hex 32
ENCRYPTION_KEY=